NODE_ENV=development
PORT=5100
LOG_LEVEL=debug
LOG_PRETTY=true
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Base URL of the SLR backend (slr-be) that provides validated review output.
SLR_API_BASE_URL=http://localhost:5000

# Development-only auth (ignored when NODE_ENV=production). Without it, or a configured token verifier, every request gets 401.
# Send `X-Dev-User-Id: <uid>` to act as another user.
DEV_AUTH_ENABLED=true
DEV_AUTH_UID=dev_user
DEV_AUTH_EMAIL=dev@slr-writing.local

# Max JSON body size. A slr-be corpus with many studies can be large.
JSON_BODY_LIMIT=50mb

# PostgreSQL. Matches docker-compose.yml (host port 5433 avoids clashing with a local Postgres on 5432).
DATABASE_URL=postgresql://slr_writing:slr_writing@localhost:5433/slr_writing?schema=public
